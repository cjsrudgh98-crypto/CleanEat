# cp .env.example .env 후 값을 채운다. .env는 git에 올리지 않는다 (.gitignore 등록됨).
# 비워둘 항목은 줄을 지우거나 주석으로 둘 것 - "KEY=" 처럼 빈 값을 넣으면 스프링이 빈 문자열로 읽는다.

# ── 필수 ──────────────────────────────────────────────
# 서버 IP를 가리키는 도메인 (무료: https://www.duckdns.org 에서 xxx.duckdns.org 발급)
DOMAIN=cleaneat.duckdns.org

# DB 비밀번호 - 랜덤 문자열 (openssl rand -base64 24)
POSTGRES_PASSWORD=change-me

# JWT 서명 키 - 32바이트 이상 랜덤 (openssl rand -base64 48)
APP_JWT_SECRET=change-me

# 토스페이먼츠 키 (포트폴리오/테스트 운영이면 테스트 키 test_ck_... / test_sk_...)
TOSS_CLIENT_KEY=test_ck_change-me
TOSS_SECRET_KEY=test_sk_change-me

# 메일(SMTP) - 운영에서는 인증번호를 화면에 안 보여주므로 없으면 회원가입 불가 (DEPLOYMENT.md 5-2)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=you@gmail.com
SPRING_MAIL_PASSWORD=gmail-app-password
MAIL_FROM=you@gmail.com

# 관리자 아이디 (쉼표로 여러 개). 이 아이디로 "가입"하는 사람이 ADMIN이 되므로,
# 먼저 사이트에서 본인 계정을 만든 뒤 그 아이디를 넣고 docker compose up -d 로 재시작할 것
# ADMIN_USERNAMES=

# ── 선택 ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
# 소셜 로그인을 켤 때: SPRING_PROFILES_ACTIVE=prod,oauth 로 바꾸고 아래 키 전부 채우기 (OAUTH_SETUP.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# JVM 힙 (기본 -Xmx768m). RAM 1GB VM이면 낮출 것
# JAVA_TOOL_OPTIONS=-Xmx384m
